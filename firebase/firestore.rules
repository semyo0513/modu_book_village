rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. users 컬렉션 (학생 및 교사 프로필)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    // 2. classes 컬렉션 (학급 나무 성장 및 열매 데이터)
    match /classes/{classId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. records 컬렉션 (독서 기록: 한 줄 피드, 비밀의 숲, 책 꼬리잇기, 가상 인터뷰)
    match /records/{recordId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;

      // 3-1. 블라인드 북 서브문서
      match /secret/book {
        allow read, write: if true;
      }

      // 3-2. 댓글 서브컬렉션
      match /comments/{commentId} {
        allow read, write: if true;
      }

      // 3-3. 이모지 공감 반응 서브컬렉션
      match /reactions/{reactionId} {
        allow read, write: if true;
      }
    }

    // 4. connections 컬렉션 (책 꼬리잇기 릴레이 연결)
    match /connections/{connId} {
      allow read, write: if true;
    }

    // 5. comments 컬렉션 (최상위 호환 댓글)
    match /comments/{commentId} {
      allow read, write: if true;
    }

    // 6. books 컬렉션 (도서 메타데이터 캐시)
    match /books/{isbn} {
      allow read, write: if true;
    }
  }
}
    }
  }
}
